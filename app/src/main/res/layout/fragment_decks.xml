<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:context=".home.decks.DecksFragment">

    <TextView
        android:id="@+id/txtDecksTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/decks_title"
        android:textColor="@color/memo_navy"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDecksSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/decks_subtitle"
        android:textColor="@color/memo_muted"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDecksTitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateDeck"
        style="@style/MemoPrimaryButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="@string/create_deck"
        app:icon="@drawable/ic_upload_file"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDecksSubtitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDecks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCreateDeck"
        tools:listitem="@layout/item_deck" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/deckProgress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:indicatorColor="@color/memo_blue"
        app:layout_constraintBottom_toBottomOf="@id/rvDecks"
        app:layout_constraintEnd_toEndOf="@id/rvDecks"
        app:layout_constraintStart_toStartOf="@id/rvDecks"
        app:layout_constraintTop_toTopOf="@id/rvDecks" />

    <TextView
        android:id="@+id/txtEmptyDecks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_decks_yet"
        android:textColor="@color/memo_muted"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvDecks"
        app:layout_constraintEnd_toEndOf="@id/rvDecks"
        app:layout_constraintStart_toStartOf="@id/rvDecks"
        app:layout_constraintTop_toTopOf="@id/rvDecks" />

</androidx.constraintlayout.widget.ConstraintLayout>
