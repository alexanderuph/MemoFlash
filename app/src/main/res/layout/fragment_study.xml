<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.study.StudyFragment">

    <LinearLayout
        android:id="@+id/studyHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/memo_navy"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/study_header_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/study_header_subtitle"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadFile"
            style="@style/MemoPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="@string/upload_file"
            app:icon="@drawable/ic_upload_file" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardsSummary"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/studyHeader"
        app:strokeColor="@color/memo_blue_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtCardsReady"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cards_ready_count"
                android:textColor="@color/memo_blue"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/cards_ready_label"
                android:textColor="@color/memo_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtFeaturedTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/featured_decks"
        android:textColor="@color/memo_navy"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardsSummary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeaturedDecks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtFeaturedTitle"
        tools:listitem="@layout/item_deck" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/studyProgress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:indicatorColor="@color/memo_blue"
        app:layout_constraintBottom_toBottomOf="@id/rvFeaturedDecks"
        app:layout_constraintEnd_toEndOf="@id/rvFeaturedDecks"
        app:layout_constraintStart_toStartOf="@id/rvFeaturedDecks"
        app:layout_constraintTop_toTopOf="@id/rvFeaturedDecks" />

    <TextView
        android:id="@+id/txtEmptyStudy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_decks_yet"
        android:textColor="@color/memo_muted"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvFeaturedDecks"
        app:layout_constraintEnd_toEndOf="@id/rvFeaturedDecks"
        app:layout_constraintStart_toStartOf="@id/rvFeaturedDecks"
        app:layout_constraintTop_toTopOf="@id/rvFeaturedDecks" />

</androidx.constraintlayout.widget.ConstraintLayout>
