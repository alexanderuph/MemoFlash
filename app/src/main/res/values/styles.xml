<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MemoPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/memo_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MemoInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/memo_blue</item>
        <item name="hintTextColor">@color/memo_muted</item>
    </style>

    <style name="MemoInputText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/memo_ink</item>
        <item name="android:textColorHint">@color/memo_muted</item>
    </style>
</resources>
